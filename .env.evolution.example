# Usar `node scripts/setup-evolution.mjs` para generar claves privadas y los archivos de Nginx.
# No completar ni subir este ejemplo con valores reales. El archivo operativo es .env.evolution.
EVOLUTION_API_KEY=
EVOLUTION_GATEWAY_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=
EVOLUTION_REDIS_PASSWORD=
EVOLUTION_PUBLIC_HOST=
MONZO_ORIGIN=
EVOLUTION_GATEWAY_PORT=18085
# Opcional, solo gateway: clave creada en Vercel → Deployment Protection. No la genera MONZO.
VERCEL_AUTOMATION_BYPASS_SECRET=
