# Copiar a .env.qr en el VPS. No versionar .env.qr ni compartir sus valores.
# Usar la misma base de MONZO, con sslmode=require en Neon.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require"
# Misma clave de 64 caracteres hexadecimales WHATSAPP_ENCRYPTION_KEY de MONZO/Vercel.
WHATSAPP_ENCRYPTION_KEY="REEMPLAZAR_CON_LA_CLAVE_EXISTENTE"
