# npm run setup:local prepara .env y .env.test sin imprimir secretos.
# Este ejemplo sirve solo para desarrollo. Nunca usar estos valores en producción.
DATABASE_URL="postgresql://monzo:monzo@localhost:5432/monzo_dev?schema=public"
# Se genera localmente; en Vercel crear un secreto aleatorio de 32 bytes o más.
BETTER_AUTH_SECRET=""
# Origen exacto del sitio. En producción debe ser HTTPS y coincidir con el dominio real.
BETTER_AUTH_URL="http://localhost:3000"
# Mailpit local: captura mensajes; no entrega correos a Internet.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="MONZO Desarrollo <cuentas@monzo.test>"
# En producción usar el proveedor SMTP, TLS y un remitente verificado.
SMTP_USER=""
SMTP_PASSWORD=""
# Docker Compose local: setup:local genera contraseñas diferentes para ambas bases.
MONZO_DEV_DB_PASSWORD=""
MONZO_TEST_DB_PASSWORD=""
# Fase 3: web y worker deben compartir estos valores (nunca NEXT_PUBLIC_*).
# Clave hex de 32 bytes para cifrar tokens de WhatsApp. Conservarla: cambiarla exige recifrar.
WHATSAPP_ENCRYPTION_KEY=""
# App Secret real de Meta, usado para verificar la firma de los webhooks.
WHATSAPP_APP_SECRET=""
# Token aleatorio que se ingresa también al configurar el webhook en Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION="v25.0"
# Redis local con contraseña; en producción el worker exige rediss:// (TLS).
MONZO_REDIS_PASSWORD=""
REDIS_URL=""
# Mismo prefijo en las réplicas del worker que comparten una base; distinto entre entornos.
WHATSAPP_QUEUE_PREFIX="monzo-whatsapp"
# Para Vercel + QStash (sin Redis ni proceso permanente): WHATSAPP_PROCESSOR="qstash".
# Mantener bullmq para el worker local o un alojamiento permanente propio.
WHATSAPP_PROCESSOR="bullmq"
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# OpenAI y agentes IA se incorporarán en otra fase.

# Gemini lab: server-only key from a Free tier project without billing enabled.
# Never use NEXT_PUBLIC_ or commit a real key. Requires Phase 6 migration.
GEMINI_API_KEY=
