# Desarrollo local solamente. Nunca usar credenciales de producción.
# Copiar a .env; Prisma CLI lo lee automáticamente. Next.js lee .env / .env.local.
DATABASE_URL="postgresql://monzo:monzo@localhost:5432/monzo_dev?schema=public"
# No se requieren claves de OpenAI, Meta ni Redis en Fase 1.
# Tests de interfaz no acceden a la base. Una futura suite de integración deberá
# usar una base monzo_test separada; producción se configura en el proveedor.
