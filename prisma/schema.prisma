generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  memberships           Membership[]
  emailVerified         Boolean            @default(false)
  image                 String?
  sessions              Session[]
  accounts              Account[]
  assignedConversations Conversation[]     @relation("AssignedAgent")
  sentMessages          Message[]          @relation("MessageAuthor")
  conversationNotes     ConversationNote[]
}

model Tenant {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       Membership[]
  settings          TenantSettings?
  invitations       TenantInvitation[]
  whatsappAccounts  WhatsappAccount[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[]
  webhookEvents     WhatsappWebhookEvent[]
  conversationNotes ConversationNote[]
  whatsappTemplates WhatsappTemplate[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
}

model TenantSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  timezone  String   @default("America/Argentina/Buenos_Aires")
  locale    String   @default("es-AR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model TenantInvitation {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email     String
  role      MembershipRole @default(MEMBER)
  tokenHash String         @unique
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@unique([tenantId, email])
  @@index([expiresAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
  CANCELED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model WhatsappAccount {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  phoneNumberId        String                 @unique
  businessAccountId    String
  displayPhone         String
  displayName          String
  tokenEncrypted       String?
  enabled              Boolean                @default(false)
  lastErrorCode        String?
  verifiedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  templatesSyncedAt    DateTime?
  templatesNextCursor  String?
  templatesSyncId      String?
  templatesSyncVersion Int                    @default(0)
  contacts             Contact[]
  conversations        Conversation[]
  messages             Message[]
  webhookEvents        WhatsappWebhookEvent[]
  templates            WhatsappTemplate[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Contact {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId     String
  account       WhatsappAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  waId          String
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  conversations Conversation[]

  @@unique([tenantId, accountId, waId])
  @@unique([id, accountId, tenantId])
  @@index([tenantId, name])
}

model Conversation {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId      String
  account        WhatsappAccount    @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  contactId      String
  contact        Contact            @relation(fields: [contactId, accountId, tenantId], references: [id, accountId, tenantId], onDelete: Restrict)
  status         ConversationStatus @default(OPEN)
  assignedUserId String?
  assignedUser   User?              @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: Restrict)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  lastInboundAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       Message[]
  notes          ConversationNote[]

  @@unique([accountId, contactId])
  @@unique([id, accountId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId        String
  account          WhatsappAccount   @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  conversationId   String
  conversation     Conversation      @relation(fields: [conversationId, accountId, tenantId], references: [id, accountId, tenantId], onDelete: Restrict)
  direction        MessageDirection
  status           MessageStatus
  type             String
  text             String?
  mediaId          String?
  mediaMimeType    String?
  mediaFilename    String?
  mediaSize        Int?
  mediaSha256      String?
  templateId       String?
  templateSnapshot Json?
  template         WhatsappTemplate? @relation(fields: [templateId, accountId, tenantId], references: [id, accountId, tenantId], onDelete: Restrict)
  providerId       String?
  idempotencyKey   String?
  createdByUserId  String?
  createdByUser    User?             @relation("MessageAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  errorCode        String?
  attemptedAt      DateTime?
  jobPublishedAt   DateTime?
  occurredAt       DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([accountId, providerId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt])
  @@index([status, createdAt])
}

model ConversationNote {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text           String
  createdAt      DateTime     @default(now())

  @@index([tenantId, conversationId, createdAt])
}

model WhatsappTemplate {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId         String
  account           WhatsappAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  businessAccountId String
  providerId        String
  name              String
  language          String
  category          String
  status            String
  definition        Json
  definitionHash    String
  syncId            String
  syncedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  messages          Message[]

  @@unique([id, accountId, tenantId])
  @@unique([accountId, providerId])
  @@unique([accountId, name, language])
  @@index([tenantId, accountId, status])
}

model WhatsappWebhookEvent {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId      String
  account        WhatsappAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  digest         String
  payload        Json?
  state          String          @default("PENDING")
  attempts       Int             @default(0)
  errorCode      String?
  createdAt      DateTime        @default(now())
  processedAt    DateTime?
  jobPublishedAt DateTime?

  @@unique([accountId, digest])
  @@index([state, createdAt])
}

model WorkerHeartbeat {
  id              String   @id
  seenAt          DateTime
  outboundEnabled Boolean  @default(false)
}
