FROM evoapicloud/evolution-api:v2.3.8@sha256:b2712c06caf333c7a7ade3bbbdd25f70c32abb74537ec75f786c24c99675deb3
COPY health-patch.mjs send-id-patch.mjs LICENSE.upstream ./monzo/
RUN node ./monzo/health-patch.mjs
RUN node ./monzo/send-id-patch.mjs
# The upstream migration entrypoint needs to update its own migrations directory.
# Migration files, Prisma client output and the session volume need ownership.
RUN mkdir -p /evolution/instances && chown -R node:node /evolution/prisma /evolution/instances /evolution/node_modules/.prisma
ENV NPM_CONFIG_CACHE=/tmp/npm
USER node
