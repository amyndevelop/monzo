{
  "name": "monzo",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/test.mjs --ui",
    "test:qstash": "node scripts/test.mjs --qstash",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "check": "npm run db:validate && npm run typecheck && npm run lint && npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "docker compose up -d --wait",
    "services:stop": "docker compose stop",
    "db:migrate": "prisma migrate deploy",
    "worker": "node --env-file-if-exists=.env --import tsx workers/whatsapp.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@upstash/qstash": "^2.12.1",
    "better-auth": "^1.7.14",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "22.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
